{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "keyword",
      "purple",
      "green",
      "warning",
      "yellow",
      "cyan",
      "red",
      "blue"
    ],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.400"
        },
        "destructive": {
          "base": "#ffffff",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": {
          "base": "#ff0000"
        },
        "warning": {
          "base": "#ff8f3a"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "info": {
          "base": "$hue.blue.400"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.600",
          "$focused": "$hue.interactive.600",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.400"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.400"
    },
    "scrollbar": {
      "base": "$hue.accent.400"
    },
    "diff": {
      "text": {
        "added": "#3cbc66",
        "removed": "#FA7883",
        "context": "$text.muted",
        "hunkHeader": "#CE33C0"
      },
      "background": {
        "added": "#c5f6c8",
        "removed": "#fac1c6",
        "context": "$background.base"
      },
      "highlight": {
        "added": "#23974A",
        "removed": "#ff0000"
      },
      "lineNumber": {
        "text": "$text.muted",
        "background": {
          "added": "#c5f6c8",
          "removed": "#fac1c6"
        }
      }
    },
    "syntax": {
      "comment": "#A0A1A7",
      "keyword": "#0098DD",
      "function": "#23974A",
      "variable": "#823FF1",
      "string": "#C5A332",
      "number": "#CE33C0",
      "type": "#D52753",
      "operator": "#7A82DA",
      "punctuation": "#7A82DA"
    },
    "markdown": {
      "text": "#383A42",
      "heading": "#0098DD",
      "link": "#275FE4",
      "linkText": "#823FF1",
      "code": "#A05A48",
      "blockQuote": "#823FF1",
      "emphasis": "#DF631C",
      "strong": "#D52753",
      "horizontalRule": "#A0A1A7",
      "listItem": "#7A82DA",
      "listEnumeration": "#7A82DA",
      "image": "#275FE4",
      "imageText": "#823FF1",
      "codeBlock": "#383A42"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          },
          "secondary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
